# ==============================================================================
# SPENTICA CHEMICALS — PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env or configure in your deployment dashboard (e.g. Vercel, Railway)
# ==============================================================================

# Database Connection (PostgreSQL with connection pooling)
DATABASE_URL="postgresql://user:password@localhost:5432/spentica_db?sslmode=require"

# Authentication & Security
JWT_SECRET="generate-a-strong-64-character-random-secret-key-for-production"
CSRF_SECRET="generate-a-strong-random-csrf-secret-key"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# External API Access (e.g., automated document upload & notification triggers)
API_KEY="your-production-secret-api-key"

# Cloud Storage for PDFs & Images (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Optional: Vercel Blob Storage (alternative document storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxx"

# Optional: Firebase Service Account for Mobile Push Notifications (FCM)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'
